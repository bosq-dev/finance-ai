# Chave da API Anthropic — obrigatória (LLM dos agentes + web_search nativo).
ANTHROPIC_API_KEY=

# Opcional: modelo usado pelos agentes CrewAI (default: anthropic/claude-sonnet-4-6).
# CREWAI_MODEL=anthropic/claude-sonnet-4-6

# Opcional: modelo usado pela tool de web_search (default: claude-sonnet-4-6).
# ANTHROPIC_SEARCH_MODEL=claude-sonnet-4-6

# Opcional: número máximo de buscas por chamada de web_search (default: 5).
# WEB_SEARCH_MAX_USES=5
